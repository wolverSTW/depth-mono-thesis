# Copy to project-root local.vast.env. Do not put credentials in this file.
export TASK_ROOT=/workspace/depth-monoia
# The common wrapper derives dataset/output/cache paths from TASK_ROOT.
export ENV_NAME=depth-monoia-gpu
export GPU_DEVICE=0
export MAX_JOBS=4
# Keep batch 16 by default. Only set after reviewing an actual OOM and the
# reproduction tradeoff. Apply the SAME setting to A0/A1/A2/A3 and use new runs.
# export VAST_BATCH_SIZE=8
# export VAST_WORKERS=4
# export REFERENCE_PREDICTIONS=/workspace/depth-monoia/evidence/val_predictions
# export REFERENCE_METRICS=/workspace/depth-monoia/evidence/val_reference.json
